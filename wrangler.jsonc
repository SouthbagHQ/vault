{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Account freeze: `wrangler secret put IDENTITY_INTERNAL_SECRET` (Vault's entry from
  // Identity's INTERNAL_API_SECRETS, key "southbag-vault"). Required in production -
  // npm run deploy checks.
  "name": "southbag-vault",
  "account_id": "1044a3131c99356eba069325d3be3788",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "routes": [{ "pattern": "vault.southbag.cc", "custom_domain": true }],
  // Otherwise `wrangler dev` rewrites request URLs to the route's host, which breaks local
  // sign-in and the localhost-only test setup.
  "dev": { "host": "localhost:8787" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Static files are served for free without waking the Worker. Only these paths run code.
    "run_worker_first": ["/api/*", "/auth/*"],
    "not_found_handling": "single-page-application"
  },
  // Credentials (plaintext, by charter), sessions and the fee ledger: one D1 database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "southbag-vault",
      "database_id": "3f0579eb-e4e8-47a9-a812-eeb0d8ea6c3c",
      "migrations_dir": "migrations"
    }
  ],
  // Fees are taken from Southbag Online Banking through its Billing entrypoint
  // (RPC, not public). Deploy banking first. See src/lib/banking.ts.
  "services": [{ "binding": "BANKING", "service": "southbag-online-banking", "entrypoint": "Billing" }],
"observability": { "enabled": true }
}
